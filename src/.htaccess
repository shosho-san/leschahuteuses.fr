Options -Indexes
DirectoryIndex index.html

RewriteEngine On

RewriteCond %{HTTP_HOST} ^leschahuteuses\.fr$ [NC]
RewriteRule ^ https://www.leschahuteuses.fr%{REQUEST_URI} [R=301,L]

RewriteRule ^favicon\.ico$ img/logo.png [L]

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} != 'www.leschahuteuses.fr'"
</IfModule>

RewriteCond %{HTTP_HOST} !^www\.leschahuteuses\.fr$ [NC]
RewriteRule ^robots\.txt$ robots-recette.txt [L]

RewriteCond %{HTTP_HOST} !^www\.leschahuteuses\.fr$ [NC]
RewriteRule ^sitemap\.xml$ - [R=404,L]

RewriteRule ^le-cabaret-du-chahut/?$ /#formats [R=301,L,NE]
RewriteRule ^nos-formats/le-cabaret-du-chahut/?$ /#formats [R=301,L,NE]

RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/(login|logout|setup)/?$ admin/index.php?action=$1 [L,QSA]
RewriteRule ^api/(content|session|upload|instagram)/?$ api/index.php?route=$1 [L,QSA]
