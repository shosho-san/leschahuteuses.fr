Options -Indexes
DirectoryIndex index.html

RewriteEngine On

RewriteCond %{HTTP_HOST} ^leschahuteuses\.fr$ [NC]
RewriteRule ^ https://www.leschahuteuses.fr%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^www\.leschahuteuses\.fr$ [NC]
RewriteRule ^ https://www.leschahuteuses.fr%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^www\.leschahuteuses\.fr$ [NC]
RewriteCond %{HTTP_HOST} !^leschahuteuses\.fr$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^favicon\.ico$ img/logo-280.png [L]

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} != 'www.leschahuteuses.fr'"
  <FilesMatch "\.(?:css|js|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

RewriteCond %{HTTP_HOST} !^www\.leschahuteuses\.fr$ [NC]
RewriteRule ^robots\.txt$ robots-recette.txt [L]

RewriteCond %{HTTP_HOST} !^www\.leschahuteuses\.fr$ [NC]
RewriteRule ^sitemap\.xml$ - [R=404,L]

# Anciennes URLs WordPress : indiquer explicitement que ces endpoints ont disparu.
RewriteRule ^wp-(admin|content|includes|json)(/.*)?$ - [G,L]
RewriteRule ^feed/?$ - [G,L]

RewriteRule ^le-cabaret-du-chahut/?$ /#formats [R=301,L,NE]
RewriteRule ^nos-formats/le-cabaret-du-chahut/?$ /#formats [R=301,L,NE]

RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/(login|logout|setup)/?$ admin/index.php?action=$1 [L,QSA]
RewriteRule ^api/(content|session|upload)/?$ api/index.php?route=$1 [L,QSA]
